{
  "name": "@getmunin/web",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "wait-on -t 60000 tcp:3001 && next dev --port 3000",
    "start": "next start --port 3000",
    "typecheck": "next typegen && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@getmunin/dashboard-pages": "workspace:*",
    "@getmunin/docs-pages": "workspace:*",
    "@getmunin/sdk": "workspace:*",
    "@getmunin/types": "workspace:*",
    "@getmunin/ui": "workspace:*",
    "@sentry/nextjs": "^10.73.0",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.38.0",
    "next": "^16.3.4",
    "next-intl": "^4.14.2",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
