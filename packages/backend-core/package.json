{
  "name": "@getmunin/backend-core",
  "version": "5.56.0",
  "license": "MIT",
  "description": "Shared NestJS modules powering both OSS and cloud Munin backends.",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/getmunin/munin.git",
    "directory": "packages/backend-core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./docs-fixtures/mcp-tools.json": "./docs-fixtures/mcp-tools.json",
    "./docs-fixtures/skills.json": "./docs-fixtures/skills.json",
    "./openapi.json": "./openapi.json"
  },
  "files": [
    "dist",
    "src",
    "docs-fixtures",
    "openapi.json",
    "!**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ./scripts/copy-skills.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "openapi:generate": "node --import @swc-node/register/esm-register ./scripts/generate-openapi.ts",
    "docs:generate": "pnpm openapi:generate && node --import @swc-node/register/esm-register ./scripts/generate-docs-fixtures.ts",
    "test:self-service-mcp": "node --import @swc-node/register/esm-register ./scripts/test-self-service-mcp.ts",
    "mcp:sweep": "node --import @swc-node/register/esm-register ./scripts/mcp-sweep.ts",
    "smoke:dataforseo": "node --import @swc-node/register/esm-register ./scripts/dataforseo-smoke.ts",
    "backfill:inline-email-images": "node --import @swc-node/register/esm-register ./scripts/backfill-inline-email-images.ts"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "^1.7.28",
    "@getmunin/agent-runtime": "workspace:*",
    "@getmunin/core": "workspace:*",
    "@getmunin/db": "workspace:*",
    "@getmunin/emails": "workspace:*",
    "@getmunin/inspector-app": "workspace:*",
    "@getmunin/mcp-toolkit": "workspace:*",
    "@getmunin/types": "workspace:*",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/core": "2.4.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "^12.6.1",
    "@nestjs/platform-express": "^12.6.1",
    "@nestjs/schedule": "^12.0.4",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/throttler": "^6.8.0",
    "better-auth": "^1.7.28",
    "cron": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "imapflow": "^2.12.2",
    "jose": "^6.2.18",
    "libphonenumber-js": "^1.13.17",
    "mailparser": "^3.15.0",
    "marked": "^18.3.0",
    "maxmind": "^5.1.0",
    "mjml": "^5.4.1",
    "nestjs-zod": "^5.6.0",
    "nodemailer": "^10.6.1",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@getmunin/eslint-config": "workspace:*",
    "@getmunin/tsconfig": "workspace:*",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.9.0",
    "@types/mjml": "^5.4.2",
    "@types/node": "^24.19.4",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.6.0",
    "vitest": "^4.1.12"
  }
}
