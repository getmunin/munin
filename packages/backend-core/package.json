{
  "name": "@getmunin/backend-core",
  "version": "5.14.0",
  "license": "MIT",
  "description": "Shared NestJS modules powering both OSS and cloud Munin backends.",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/getmunin/munin.git",
    "directory": "packages/backend-core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./docs-fixtures/mcp-tools.json": "./docs-fixtures/mcp-tools.json",
    "./docs-fixtures/skills.json": "./docs-fixtures/skills.json",
    "./openapi.json": "./openapi.json"
  },
  "files": [
    "dist",
    "src",
    "docs-fixtures",
    "openapi.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ./scripts/copy-skills.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "openapi:generate": "node --import @swc-node/register/esm-register ./scripts/generate-openapi.ts",
    "docs:generate": "pnpm openapi:generate && node --import @swc-node/register/esm-register ./scripts/generate-docs-fixtures.ts",
    "test:self-service-mcp": "node --import @swc-node/register/esm-register ./scripts/test-self-service-mcp.ts",
    "mcp:sweep": "node --import @swc-node/register/esm-register ./scripts/mcp-sweep.ts"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "^1.7.2",
    "@getmunin/agent-runtime": "workspace:*",
    "@getmunin/core": "workspace:*",
    "@getmunin/db": "workspace:*",
    "@getmunin/emails": "workspace:*",
    "@getmunin/inspector-app": "workspace:*",
    "@getmunin/mcp-toolkit": "workspace:*",
    "@getmunin/types": "workspace:*",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/schedule": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/throttler": "^6.5.0",
    "better-auth": "^1.7.2",
    "cron": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "imapflow": "^1.7.7",
    "jose": "^6.2.10",
    "libphonenumber-js": "^1.13.12",
    "mailparser": "^3.9.19",
    "marked": "^18.0.11",
    "maxmind": "^5.0.7",
    "nestjs-zod": "^5.5.0",
    "nodemailer": "^9.1.0",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@getmunin/eslint-config": "workspace:*",
    "@getmunin/tsconfig": "workspace:*",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.1",
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.11"
  }
}
