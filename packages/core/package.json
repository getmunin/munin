{
  "name": "@getmunin/core",
  "version": "5.55.0",
  "license": "MIT",
  "description": "Munin core: actor identity, request context, mailer, storage, crypto helpers.",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/getmunin/munin.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./errors": {
      "development": "./src/errors.ts",
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@getmunin/db": "workspace:*",
    "@getmunin/types": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.18",
    "nodemailer": "^10.6.1",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@getmunin/eslint-config": "workspace:*",
    "@getmunin/tsconfig": "workspace:*",
    "@types/node": "^24.19.4",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
