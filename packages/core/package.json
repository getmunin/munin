{
  "name": "@getmunin/core",
  "version": "5.43.0",
  "license": "MIT",
  "description": "Munin core: actor identity, request context, mailer, storage, crypto helpers.",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/getmunin/munin.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@getmunin/db": "workspace:*",
    "@getmunin/types": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.10",
    "nodemailer": "^10.0.13",
    "undici": "^7.29.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@getmunin/eslint-config": "workspace:*",
    "@getmunin/tsconfig": "workspace:*",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
