{
  "name": "@getmunin/ui",
  "version": "5.14.0",
  "license": "MIT",
  "description": "Munin design-system primitives (shadcn-style) shared between OSS and cloud Next apps.",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/getmunin/munin.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tailwind-preset": "./src/tailwind-preset.ts",
    "./styles/fonts.css": "./src/styles/fonts.css",
    "./styles/tokens.css": "./src/styles/tokens.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@getmunin/types": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.38.0",
    "next-themes": "^0.4.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@getmunin/eslint-config": "workspace:*",
    "@getmunin/tsconfig": "workspace:*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
}
